{% extends "layout.html" %}

{% set article = data.content %}
{% set title = article.title or "article" %}
{% set url = AP_BASE_URL ~ data.full_slug %}
{% set description = article.intro or "article" %}

{% if article.file and article.file.filename %}
{% set image_params = '' if article.file.is_external_url else '/m/fit-in/720x450/filters:format(webp)' %}
{% set image_meta_params = '' if article.file.is_external_url else '/m/fit-in/510x240/filters:format(webp)' %}
{% set image = article.file.filename ~ image_params %}
{% set image_meta = article.file.filename ~ image_meta_params %}
{% set img_alt = article.file.alt or ('Image for ' ~ title|lower) %}
{% endif %}

{% block title %}{{ title }}{% endblock %}

{% block meta %}
<link rel="canonical" href="{{ url }}">

<meta name="description" content="{{ description }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ url }}">
{% if image %}
<meta property="og:image" content="{{ image_meta }}">
{% endif %}
<meta property="og:type" content="article">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
{% if image %}
<meta name="twitter:image" content="{{ image_meta }}">
{% endif %}
{% endblock %}

{% block main %}
<time datetime="{{ article.date }}"><small>{{ article.date|date_format }}</small></time>
<h1>{{ title }}</h1>
{% if image %}
<img src="{{ image }}" alt="{{ img_alt }}" width="720" height="450" fetchpriority="high">
{% endif %}
<h2>{{ description }}</h2>
<article>{{ article.long_text|safe }}</article>
{% endblock %}